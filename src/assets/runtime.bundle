      trackActivePaneFromTarget(ev?.target, true);
    } catch {}
  };

  const onDocPointerDown = (ev) => {
    try {
      wakeWinBlur();
      const t = ev?.target;
      if (t?.closest) {
        trackActivePaneFromTarget(t, true);
        const sbRow = cl(t, '[data-testid="conversation-row-sidebar"]');
