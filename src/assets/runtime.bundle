  // Channel 9 内置 8 语种存储明细与归档工作台文案（0 B 进 Ch1，完整 8 语、无废弃 yue、未知语种回退 en）
  const STORAGE_WB_UI = O.freeze({
    'zh-CN': O.freeze({
