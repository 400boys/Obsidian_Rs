    else { ra(h, 'data-ag-cs-model-menu'); qa(D, '[data-ag-cs-model-overlay]').forEach((el) => ra(el, 'data-ag-cs-model-overlay')); }
  };

  const measureCardClr = (card, ib, act, isPri = true, m = null, pTk = null) => {
    if (!ib) return null;
