        || Math.abs(surge - lastSurge) >= 0.001
        || Math.abs(speed - lastSpeed) >= 0.005;
      const isGpuGlow = Boolean(renderer && renderer.mode === 'webgl2');
      const frameGap = isGpuGlow ? 0 : (ext ? 14 : (basePresence < 1 ? 33 : 42));
      if (!stale && !dirty && (still || (frameGap > 0 && Math.abs(nowMs - lastDrawMs) < frameGap))) {
        if (forceStatic) sleeping = true;
        return false;
      }
      let dtSec = 0;
      if (forceStatic) {
        if (flowSec === 0) flowSec = 2.4;
        lastClockMs = nowMs;
        sleeping = true;
      } else if (still) {
        lastClockMs = nowMs;
        sleeping = true;
      } else {
        sleeping = false;
        if (lastClockMs === null || nowMs < lastClockMs) {
          if (lastClockMs === null) flowSec = Math.min(2.4, realSec * speed);
          lastClockMs = nowMs;
        } else {
          dtSec = Math.min(0.35, Math.max(0, (nowMs - lastClockMs) / 1000));
          lastClockMs = nowMs;
          flowSec += dtSec * speed;
        }
      }
      if (semanticCode > 0) holdSem = semanticCode;
      if (forceStatic || still) {
        semMix = semanticCode > 0 ? 1 : 0;
      } else {
        const tgt = semanticCode > 0 ? 1 : 0;
        const step = Math.min(1, Math.max(0.04, dtSec / 0.45));
        semMix += (tgt - semMix) * step;
        if (Math.abs(tgt - semMix) < 0.01) semMix = tgt;
      }
      const effSem = holdSem > 0 && semMix > 0.005 ? holdSem + (1 - semMix) * 0.98 : 0;
      const breath = forceStatic
        ? 0.64
        : (still ? 0.58 : 0.46 + 0.24 * Math.sin(flowSec * 1.15) + 0.06 * Math.sin(flowSec * 2.05 + 0.9));
      const isDefaultHome = !ext && strength >= 0.999;
      const intensity = isDefaultHome ? breath * (0.2 + 0.8 * strength) : breath * (0.55 + 0.45 * strength);
      const strengthGain = strength <= 0 ? 0 : (strength >= 0.999 ? 1 : Math.pow(strength, 0.78));
      const presence = basePresence * strengthGain;
      renderer.draw(canvas.width, canvas.height, dpr, 12 + flowSec, dark, intensity, presence, reach, prism, surge, speed, spectrumCode, effSem);
      clearedZero = false;
      lastDrawMs = nowMs;
      lastDark = dark;
      lastStrength = strength;
      lastReach = reach;
      lastPrism = prism;
      lastSurge = surge;
      lastSpeed = speed;
      lastSpectrum = spectrumCode;
      lastSemantic = semanticCode;
      stale = false;
      return true;
    }
    return {
      mode: renderer ? renderer.mode : 'none',
      isContextLost: () => Boolean(renderer && renderer.isContextLost && renderer.isContextLost()),
      resize(w, h, nextDpr) {
        syncSize(w, h, nextDpr);
      },
      invalidate() {
        stale = true;
      },
      clear: clearCanvas,
      setAuraParams,
      getAuraParams() {
        return { ...activeAura };
      },
      getExtendedState() {
        return {
          ...activeAura,
          spectrum: activeSpectrum,
          semantic: activeSemantic,
          ambientIntensity: activeAmbient,
          sleeping,
        };
      },
      isSleeping() {
        return sleeping;
      },
      draw(nowInput, isDarkOrOpts = {}, strengthArg, extraArg) {
        return renderInternal(nowInput, isDarkOrOpts, strengthArg, extraArg, false);
      },
      drawStaticSnapshot(nowInput, isDarkOrOpts = {}, strengthArg, extraArg) {
        stale = true;
        return renderInternal(nowInput, isDarkOrOpts, strengthArg, extraArg, true);
      },
      dispose(keep) {
        sleeping = true;
        if (canvas.removeEventListener) {
          canvas.removeEventListener('webglcontextlost', onContextLost);
          canvas.removeEventListener('webglcontextrestored', onContextRestored);
        }
        if (renderer) renderer.dispose(keep);
      },
    };
  }
  return {
    RIPPLE,
    SPECTRUM,
    SPECTRUM_LIGHT,
    HORIZON_SPECTRUM,
    HORIZON_PRISM_STOPS,
    HORIZON_DAYLIGHT_STOPS,
    HORIZON_SPECTRUM_MODES,
    HORIZON_SEMANTIC_MODES,
    HORIZON_FRAGMENT_SHADER,
    GLOW_FRAG_SHADER,
    DEFAULT_HORIZON_AURA,
    GLYPHS,
    hash,
    valueNoise,
    fractalNoise,
    glyphIndex,
    cloudClear,
    patchClear,
    spectrumRgb,
    horizonPrismRgb,
    resolveHorizonSpectrumCode,
    resolveHorizonSemanticCode,
    resolveHorizonDpr,
    computeNebulaLobes,
    createWaveField,
    parseCssColorToRgb,
    parseAmbientScale,
    createGlyphField,
    mountBrandHorizonGlow,
  };
});


// --- MODULE: conv-aura.js ---
// Obsidian Prism — Multi-State Semantic Conversation Horizon Aura Controller (.ag-cs-conv-aura-host)
// Split-Rate 300Hz VSync (~30fps cap in running, 1200ms idle settle -> 0fps) + Ambient Intensity + 3-State 0fps Semantic Afterglow.

(function (root) {
  'use strict';
  const G = root || (typeof globalThis !== 'undefined' ? globalThis : window);
  if (!G) return;

  const CONV_AURA_HEIGHT_RATIO = 0.32;
  const CONV_AURA_START_MS = 1150;
  const CONV_AURA_COMPLETE_MS = 1400;
  const CONV_AURA_IDLE_SLEEP_MS = 1200;
  const CONV_AURA_DECISION_BREATH_MS = 1600;
  const CONV_AURA_DECISION_CLEAR_MS = 400;
  const CONV_AURA_ERROR_MS = 900;
  const CONV_AURA_LONG_TASK_THRESHOLD_MS = 15000;
  const CONV_AURA_LONG_COMPLETE_MS = 1200;
  const CONV_AURA_FOCUS_FADE_MS = 600;

  function scaleConvReach(fullViewportReach) {
    return Math.max(0.08, Math.min(0.98, +(fullViewportReach / CONV_AURA_HEIGHT_RATIO).toFixed(4)));
  }

  function clamp01(v, fallback = 1) {
    const n = Number(v);
    return Number.isFinite(n) ? Math.max(0, Math.min(1, n)) : fallback;
  }

  function isVisibleAuraNode(el, skipSyncVis = false) {
    if (!el || el.hidden === true || el.isConnected === false) return false;
    const st = el.style;
    if (st && (st.display === 'none' || st.visibility === 'hidden' || st.opacity === '0')) return false;
    if (typeof el.closest === 'function' && el.closest('[hidden], .hidden')) return false;
    if (!skipSyncVis && typeof el.checkVisibility === 'function' && !el.checkVisibility()) return false;
    return true;
  }

  let cachedRunningVal = false;
  let cachedRunningAt = -1;
  let cachedRunningEl = null;
  let cachedRunningScope = null;
  let cachedDecisionVal = false;
  let cachedDecisionAt = -1;
  let cachedDecisionEl = null;
  let cachedDecisionScope = null;
  let cachedErrorAt = -1;
  let lastFullVisAt = -1;
  const seenErrorNodes = typeof WeakSet === 'function' ? new WeakSet() : null;

  function readNowMs() {
    return typeof performance !== 'undefined' && performance.now ? performance.now() : Date.now();
  }

  const RUNNING_SEL =
    '[data-testid="input-cancel-button"], [data-testid="stop-button"], [data-testid="cancel-button"], [data-testid="agent-loading"], [data-testid="thinking-collapsible-trigger"][data-op-thought-state="streaming"]';
  const DECISION_SEL = '[data-testid="interaction-takeover-card"], [data-testid="side-question-panel"]';
  const SUBAGENT_SEL = '[data-testid="subagent-tab-conversation"]';

  function isWithinScope(el, scope) {
    if (!el) return false;
    if (!scope || scope === document) return true;
    if (el === scope) return true;
    if (typeof scope.contains === 'function' && scope.contains(el)) return true;
    const ownerView = el.closest?.('[data-testid="conversation-view"]') || null;
    if (ownerView) return ownerView === scope;
    const allViews =
      typeof document !== 'undefined' && typeof document.querySelectorAll === 'function'
        ? document.querySelectorAll('[data-testid="conversation-view"]')
        : null;
    return !allViews || allViews.length <= 1;
  }

  function isLiveMatchedIndicator(el, sel, skipSyncVis = false, scope = null) {
    return Boolean(
      el &&
        el.isConnected === true &&
        typeof el.nodeType === 'number' &&
        typeof el.matches === 'function' &&
        el.matches(sel) &&
        !el.closest?.(SUBAGENT_SEL) &&
        isWithinScope(el, scope) &&
        isVisibleAuraNode(el, skipSyncVis)
    );
  }

  function queryScopedIndicator(scope, sel, skipSyncVis) {
    const nodes = scope.querySelectorAll(sel);
    for (const n of nodes) {
      if (n.closest?.(SUBAGENT_SEL)) continue;
      if (isVisibleAuraNode(n, skipSyncVis)) return n;
    }
    if (scope !== document && typeof document.querySelectorAll === 'function') {
      const allViews = document.querySelectorAll('[data-testid="conversation-view"]');
      const singlePane = !allViews || allViews.length <= 1;
      const docNodes = document.querySelectorAll(sel);
      for (const n of docNodes) {
        if (n.closest?.(SUBAGENT_SEL)) continue;
        const ownerView = n.closest?.('[data-testid="conversation-view"]') || null;
        if (ownerView && ownerView !== scope) continue;
        if (!ownerView && !singlePane) continue;
        if (isVisibleAuraNode(n, skipSyncVis)) return n;
      }
    }
    return null;
  }

  function isConvRunning(skipSyncVis = false, scopeEl = null) {
    if (typeof document === 'undefined') return false;
    const scope = scopeEl && typeof scopeEl.querySelectorAll === 'function' ? scopeEl : document;
    const now = readNowMs();
    if (cachedRunningScope === scope && cachedRunningAt >= 0 && Math.abs(now - cachedRunningAt) < 200) {
      return cachedRunningVal;
    }
    if (cachedRunningScope === scope && isLiveMatchedIndicator(cachedRunningEl, RUNNING_SEL, skipSyncVis, scope)) {
      cachedRunningVal = true;
      cachedRunningAt = now;
      if (!skipSyncVis) lastFullVisAt = now;
      return true;
    }
    cachedRunningEl = queryScopedIndicator(scope, RUNNING_SEL, skipSyncVis);
    const running = Boolean(cachedRunningEl);
    cachedRunningScope = scope;
    cachedRunningVal = running;
    cachedRunningAt = now;
    if (!skipSyncVis) lastFullVisAt = now;
    return running;
  }

  function isAwaitingDecision(skipSyncVis = false, scopeEl = null) {
    if (typeof document === 'undefined') return false;
    const scope = scopeEl && typeof scopeEl.querySelectorAll === 'function' ? scopeEl : document;
    const now = readNowMs();
    if (cachedDecisionScope === scope && cachedDecisionAt >= 0 && Math.abs(now - cachedDecisionAt) < 200) {
      return cachedDecisionVal;
    }
    if (cachedDecisionScope === scope && isLiveMatchedIndicator(cachedDecisionEl, DECISION_SEL, skipSyncVis, scope)) {
      cachedDecisionVal = true;
      cachedDecisionAt = now;
      return true;
    }
    cachedDecisionEl = queryScopedIndicator(scope, DECISION_SEL, skipSyncVis);
    const awaiting = Boolean(cachedDecisionEl);
    cachedDecisionScope = scope;
    cachedDecisionVal = awaiting;
    cachedDecisionAt = now;
    return awaiting;
  }

  function consumeFreshDomError(convView) {
    if (!seenErrorNodes || typeof document === 'undefined') return false;
    const now = readNowMs();
    if (cachedErrorAt >= 0 && Math.abs(now - cachedErrorAt) < 240) return false;
    cachedErrorAt = now;
    const scope = convView || document;
    if (typeof scope.querySelectorAll !== 'function') return false;
    const errs = scope.querySelectorAll(
      '.ag-cs-thinking-spark[data-state="error"], [data-testid="agent-error"], [role="alert"][data-error="true"]'
    );
    let hitFresh = false;
    for (const n of errs) {
      if (n.closest?.('[data-testid="subagent-tab-conversation"]')) continue;
      if (!seenErrorNodes.has(n) && isVisibleAuraNode(n)) {
        seenErrorNodes.add(n);
        hitFresh = true;
      }
    }
    return hitFresh;
  }

  const OPTICS_BUF = { strength: 0, reach: 0.5, prism: 0, surge: 0, speed: 0, semantic: 'none', frameMs: 110 };
  const DRAW_EXTRA_BUF = { reach: 0.5, prism: 0, surge: 0, speed: 0, semantic: 'none', ambientIntensity: 1, still: false, spectrum: undefined };

  function fillOptics(out, strength, reach, prism, surge, speed, semantic, frameMs) {
    out.strength = strength;
    out.reach = reach;
    out.prism = prism;
    out.surge = surge;
    out.speed = speed;
    out.semantic = semantic;
    out.frameMs = frameMs;
    return out;
  }

  function computeConvAuraOptics(phase, phaseAt, now, dark, wasRunning, out = {}) {
    const idleStr = dark ? 0.21 : 0.52;
    const runBase = dark ? 0.31 : 0.64;
    const idlePrism = dark ? 0.14 : 0.26;
    if (phase === 'start') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_START_MS));
      const s = Math.sin(p * Math.PI);
      const peakStr = dark ? 0.46 : 0.78;
      const endStr = wasRunning ? runBase : idleStr;
      const endFullReach = wasRunning ? 0.22 : 0.16;
      const rawReach = p <= 0.5 ? 0.16 + (0.26 - 0.16) * s : endFullReach + (0.26 - endFullReach) * s;
      const endPrism = wasRunning ? 0.70 : idlePrism;
      const settleEase = Math.pow(p, 2.4);
      const endSpeed = wasRunning ? 1.45 : 0.72;
      return fillOptics(
        out,
        p <= 0.5 ? idleStr + (peakStr - idleStr) * s : endStr + (peakStr - endStr) * s,
        scaleConvReach(rawReach),
        p <= 0.5 ? idlePrism + (0.74 - idlePrism) * s : endPrism + (0.74 - endPrism) * s,
        Number((0.50 * (1 - 0.32 * settleEase)).toFixed(4)),
        Number((1.95 - (1.95 - endSpeed) * settleEase).toFixed(4)),
        'none',
        22
      );
    }
    if (phase === 'running') {
      return fillOptics(
        out,
        runBase + (dark ? 0.035 : 0.045) * Math.sin(now * 0.0021),
        scaleConvReach(0.22),
        0.70,
        0.025 * (1 + Math.sin(now * 0.0016)),
        1.45,
        'none',
        32
      );
    }
    if (phase === 'awaiting-decision') {
      const elapsed = Math.max(0, now - phaseAt);
      const p = Math.min(1, elapsed / CONV_AURA_DECISION_BREATH_MS);
      const wave = p < 1 ? Math.sin(p * Math.PI * 2) * (1 - 0.35 * p) : 0;
      const baseHold = dark ? 0.22 : 0.42;
      return fillOptics(
        out,
        Math.max(0.08, baseHold + (dark ? 0.045 : 0.065) * wave),
        scaleConvReach(0.18 + 0.025 * Math.max(0, wave)),
        0.32,
        p < 1 ? Number((0.12 * wave).toFixed(4)) : 0,
        p < 1 ? 0.85 : 0,
        'awaiting-decision',
        36
      );
    }
    if (phase === 'decision-clear') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_DECISION_CLEAR_MS));
      const ease = 1 - Math.pow(1 - p, 2);
      const startHold = dark ? 0.22 : 0.42;
      return fillOptics(
        out,
        startHold * (1 - ease),
        scaleConvReach(0.18 - 0.04 * ease),
        0.24 * (1 - ease),
        -0.14 * (1 - ease),
        0.65 * (1 - ease),
        'awaiting-decision',
        28
      );
    }
    if (phase === 'error-halted') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_ERROR_MS));
      const ease = 1 - Math.pow(1 - p, 2.2);
      const peakErr = dark ? 0.26 : 0.46;
      return fillOptics(
        out,
        peakErr * (1 - ease),
        scaleConvReach(0.21 - 0.09 * ease),
        0.36 * (1 - ease),
        Number((-0.44 * (1 - ease)).toFixed(4)),
        0.9 * (1 - 0.6 * ease),
        'error-halted',
        28
      );
    }
    if (phase === 'long-task-complete') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_LONG_COMPLETE_MS));
      const ease = 1 - Math.pow(1 - p, 2.05);
      const startStr = dark ? 0.36 : 0.62;
      const holdStr = dark ? 0.16 : 0.30;
      return fillOptics(
        out,
        startStr + (holdStr - startStr) * ease,
        scaleConvReach(0.24 + (0.17 - 0.24) * ease),
        0.52 + (0.24 - 0.52) * ease,
        Number((-0.48 * (1 - ease * 0.92)).toFixed(4)),
        1.25 + (0.55 - 1.25) * ease,
        'long-task-complete',
        28
      );
    }
    if (phase === 'focus-fade') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_FOCUS_FADE_MS));
      const ease = 1 - Math.pow(1 - p, 2);
      const holdStr = dark ? 0.16 : 0.30;
      return fillOptics(
        out,
        holdStr + (idleStr - holdStr) * ease,
        scaleConvReach(0.17 + (0.16 - 0.17) * ease),
        0.24 + (idlePrism - 0.24) * ease,
        0,
        0.55 + (0.72 - 0.55) * ease,
        'none',
        32
      );
    }
    if (phase === 'complete') {
      const p = Math.max(0, Math.min(1, (now - phaseAt) / CONV_AURA_COMPLETE_MS));
      const ease = 1 - Math.pow(1 - p, 2.1);
      const startStr = dark ? 0.38 : 0.70;
      const rawReach = 0.24 + (0.16 - 0.24) * ease;
      return fillOptics(
        out,
        startStr + (idleStr - startStr) * ease,
        scaleConvReach(rawReach),
        0.76 + (idlePrism - 0.76) * ease,
        -0.36 * (1 - ease * 0.85),
        1.45 + (0.72 - 1.45) * ease,
        'none',
