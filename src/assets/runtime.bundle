                dl += ` C${f(b[0] + (c[0] - a[0]) / 6)} ${f(cl(b[1] + (c[1] - a[1]) / 6, lo, hi))} ${f(c[0] - (e[0] - b[0]) / 6)} ${f(cl(c[1] - (e[1] - b[1]) / 6, lo, hi))} ${f(c[0])} ${f(c[1])}`;
